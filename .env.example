# Runtime database adapter: `neon` in production, `pg` for local PostgreSQL.
DATABASE_ADAPTER="neon"
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Local-only test database. `pnpm db:reset:test` refuses remote hosts and any
# database whose name is not exactly `cscn_test`.
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/cscn_test?schema=public"
ALLOW_QA_SEED="false"

# Application and Auth.js
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-long-random-secret"

# OAuth providers (optional for local email/password development)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Email
EMAIL_FROM=""
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Supabase Storage
NEXT_PUBLIC_SUPABASE_URL="https://local-preview-disabled.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="local-preview-disabled"

# Payments and media
PAYSTACK_SECRET_KEY=""
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""
MUX_WEBHOOK_SECRET=""
MUX_SIGNING_KEY_ID=""
MUX_SIGNING_KEY_SECRET=""
MUX_SIGNING_PRIVATE_KEY=""

# Protected operational endpoints
CRON_SECRET=""
SEED_ADMIN_SECRET=""
SETUP_SECRET=""
CALENDAR_TOKEN_SECRET=""
