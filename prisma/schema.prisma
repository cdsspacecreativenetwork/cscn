generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(cuid())
  firstName      String?
  lastName       String?
  name           String?
  email          String          @unique
  emailVerified  DateTime?
  image          String?
  password       String?
  role           UserRole        @default(USER)
  accounts       Account[]
  sessions       Session[]
  authenticators Authenticator[]

  bio                          String?                      @db.Text
  headline                     String?
  location                     String?
  timezone                     String?                      @default("Africa/Lagos")
  socials                      Json?
  publicProfileSlug            String?                      @unique
  publicProfileStatus          PublicProfileStatus          @default(DRAFT)
  websiteUrl                   String?
  portfolioUrl                 String?
  linkedinUrl                  String?
  twitterUrl                   String?
  instagramUrl                 String?
  youtubeUrl                   String?
  githubUrl                    String?
  behanceUrl                   String?
  dribbbleUrl                  String?
  telegramUrl                  String?
  expertise                    Json?
  learningFocus                String?
  yearsExperience              Int?
  instructorProfileEnabled     Boolean                      @default(false)
  instructorVerificationStatus InstructorVerificationStatus @default(NOT_STARTED)
  instructorVerifiedAt         DateTime?
  instructorFeatured           Boolean                      @default(false)
  instructorFeaturedOrder      Int?
  mentorshipEligible           Boolean                      @default(false)
  mentorshipEnabled            Boolean                      @default(false)
  mentorshipApprovedAt         DateTime?
  mentorshipPrice              Decimal?                     @db.Decimal(10, 2)
  mentorshipCurrency           String                       @default("NGN")
  mentorshipFree               Boolean                      @default(true)
  mentorshipBio                String?                      @db.Text
  mentorshipTopics             Json?
  mentorshipInstructions       String?                      @db.Text

  // Admin permission scopes — only relevant when role == ADMIN
  // SUPER_ADMIN implicitly has all permissions
  canManageUsers         Boolean @default(false)
  canManageCourses       Boolean @default(false)
  canReviewCourses       Boolean @default(false)
  canPublishCourses      Boolean @default(false)
  canManageLearners      Boolean @default(false)
  canManageInstructors   Boolean @default(false)
  canVerifyInstructors   Boolean @default(false)
  canManageInvites       Boolean @default(false)
  canManageAnnouncements Boolean @default(false)
  canManageBilling       Boolean @default(false)
  canManageMarketing     Boolean @default(false)
  canManagePermissions   Boolean @default(false)
  canViewAuditLogs       Boolean @default(false)
  canManageSettings      Boolean @default(false)
  canViewAnalytics       Boolean @default(false)

  marketingConsent Boolean   @default(false)
  onboardingCohort String?
  pioneerJoinedAt  DateTime?

  // Course relations
  taughtCourses                   Course[]                         @relation("InstructorCourses")
  createdResources                MarketplaceResource[]            @relation("MarketplaceResourceOwner")
  resourceAccesses                ResourceAccess[]
  resourceReviews                 ResourceReview[]                 @relation("ResourceReviewer")
  enrollments                     Enrollment[]
  purchaseOrders                  PurchaseOrder[]                  @relation("StudentOrders")
  payments                        Payment[]
  instructorEarnings              InstructorEarning[]              @relation("InstructorEarnings")
  payoutRequests                  PayoutRequest[]                  @relation("InstructorPayoutRequests")
  reviewedPayoutRequests          PayoutRequest[]                  @relation("PayoutRequestReviewer")
  payouts                         Payout[]                         @relation("InstructorPayouts")
  refundsRequested                Refund[]                         @relation("RefundRequester")
  refundsReviewed                 Refund[]                         @relation("RefundReviewer")
  invoices                        Invoice[]
  subscriptions                   UserSubscription[]
  progress                        LessonProgress[]
  lessonNotes                     LessonNote[]
  watchSegments                   LessonWatchSegment[]
  quizAttempts                    QuizAttempt[]
  courseInstructors               CourseInstructor[]
  createdScheduleEvents           ScheduleEvent[]                  @relation("ScheduleEventCreator")
  startedScheduleEvents           ScheduleEvent[]                  @relation("ScheduleEventStarter")
  endedScheduleEvents             ScheduleEvent[]                  @relation("ScheduleEventEnder")
  scheduleAttendances             ScheduleEventAttendee[]          @relation("ScheduleEventAttendees")
  mentorAvailabilities            MentorAvailability[]             @relation("MentorAvailabilities")
  mentorBookings                  MentorBooking[]                  @relation("MentorBookings")
  mentorshipBookings              MentorBooking[]                  @relation("MentorshipBookings")
  mentorshipApplications          MentorshipApplication[]          @relation("MentorshipApplications")
  reviewedMentorshipApplications  MentorshipApplication[]          @relation("MentorshipApplicationReviewer")
  cohortMentorAssignments         CohortMentorAssignment[]         @relation("CohortMentorAssignments")
  calendarConnections             CalendarConnection[]
  notifications                   Notification[]
  emailOutbox                     EmailOutbox[]
  auditLogs                       AuditLog[]                       @relation("AuditActor")
  courseReviews                   CourseReview[]
  courseFeedback                  CourseFeedbackItem[]             @relation("FeedbackAuthor")
  dailyActivities                 DailyActivity[]
  ratings                         CourseRating[]
  ledCohorts                      Cohort[]                         @relation("CohortLeadInstructor")
  cohortApplications              CohortApplication[]              @relation("CohortApplicant")
  reviewedCohortApplications      CohortApplication[]              @relation("CohortApplicationReviewer")
  cohortMemberships               CohortMembership[]
  createdCohortProjects           CohortProject[]                  @relation("CohortProjectCreator")
  projectSubmissions              ProjectSubmission[]              @relation("ProjectSubmitter")
  reviewedProjectSubmissions      ProjectSubmission[]              @relation("ProjectSubmissionReviewer")
  projectSubmissionReviews        ProjectSubmissionReview[]        @relation("ProjectReviewAuthor")
  issuedCredentials               Credential[]
  communitySpacesCreated          CommunitySpace[]                 @relation("CommunitySpaceCreator")
  communityMemberships            CommunityMembership[]
  communityPosts                  CommunityPost[]                  @relation("CommunityPostAuthor")
  communityReports                CommunityPostReport[]            @relation("CommunityReportReporter")
  communityReportsReviewed        CommunityPostReport[]            @relation("CommunityReportReviewer")
  savedCareerOpportunities        SavedCareerOpportunity[]
  careerOpportunityInterests      CareerOpportunityInterest[]
  careerTalentProfile             CareerTalentProfile?
  careerOpportunitiesCreated      CareerOpportunity[]              @relation("CareerOpportunityCreator")
  organizationsRequested          Organization[]                   @relation("OrganizationRequester")
  organizationsApproved           Organization[]                   @relation("OrganizationApprover")
  organizationMemberships         OrganizationMember[]
  organizationInvitationsSent     OrganizationInvitation[]         @relation("OrganizationInvitationSender")
  organizationSeatPackagesCreated OrganizationSeatPackage[]        @relation("OrganizationSeatPackageCreator")
  organizationSeatAllocationsMade OrganizationSeatAllocation[]     @relation("OrganizationSeatAllocator")
  organizationAssignmentsCreated  OrganizationLearningAssignment[] @relation("OrganizationAssignmentCreator")
  organizationInvoicesIssued      OrganizationInvoice[]            @relation("OrganizationInvoiceIssuer")
  learnerInterestProfile          LearnerInterestProfile?
  examAttempts                    ExamAttempt[]
  pricingProposals                CoursePricingProposal[]          @relation("PricingProposalSubmitter")
  reviewedPricingProposals        CoursePricingProposal[]          @relation("PricingProposalReviewer")
  // Streak & Gamification relations
  currentStreak                   Int                              @default(0)
  longestStreak                   Int                              @default(0)
  achievements                    UserAchievement[]
  questProgress                   UserQuestProgress[]
  leaderboardRecord               LeaderboardCache?

  // Payout Configuration
  payoutSetup   Boolean @default(false)
  payoutMethod  String?
  payoutDetails Json?

  // Security (2FA)
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publicProfileStatus])
  @@index([instructorProfileEnabled, instructorVerificationStatus])
  @@index([instructorFeatured, instructorFeaturedOrder])
  @@index([onboardingCohort])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  INSTRUCTOR
  USER
}

enum InstructorVerificationStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
}

enum PublicProfileStatus {
  DRAFT
  PUBLIC
  HIDDEN
}

enum CommunitySpaceKind {
  GENERAL
  PROGRAM
  COHORT
  TOPIC
  PROJECT_CRITIQUE
  STUDY_GROUP
  ALUMNI
}

enum CommunitySpaceVisibility {
  PUBLIC
  MEMBERS_ONLY
}

enum CommunitySpaceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CommunityMembershipRole {
  MEMBER
  MODERATOR
}

enum CommunityMembershipStatus {
  ACTIVE
  SUSPENDED
  LEFT
}

enum CommunityPostStatus {
  PUBLISHED
  REMOVED
}

enum CommunityReportReason {
  SPAM
  HARASSMENT
  UNSAFE
  MISINFORMATION
  OTHER
}

enum CommunityReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum CareerWorkplaceType {
  REMOTE
  HYBRID
  ONSITE
}

enum CareerEmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum CareerOpportunityLevel {
  ENTRY
  MID
  SENIOR
  ANY
}

enum CareerOpportunityStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum CareerOpportunityInterestStatus {
  STARTED
  APPLIED
  WITHDRAWN
}

enum OrganizationType {
  COMPANY
  NONPROFIT
  SCHOOL
  AGENCY
  COMMUNITY
  OTHER
}

enum OrganizationStatus {
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrganizationMemberRole {
  OWNER
  ADMIN
  MANAGER
  BILLING
  LEARNER
}

enum OrganizationMemberStatus {
  ACTIVE
  SUSPENDED
  LEFT
}

enum OrganizationInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum OrganizationSeatPackageStatus {
  REQUESTED
  INVOICED
  PAID
  ACTIVE
  EXPIRED
  CANCELLED
}

enum OrganizationSeatAllocationStatus {
  ACTIVE
  REVOKED
  COMPLETED
}

enum OrganizationAssignmentStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum OrganizationInvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  VOID
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique @default(uuid())
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model InviteToken {
  id        String    @id @default(cuid())
  token     String    @unique @default(cuid())
  email     String?
  role      UserRole
  createdBy String
  usedBy    String?
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())
}

// ─── Course System ────────────────────────────────────────────────────────────

model Category {
  id      String   @id @default(cuid())
  name    String   @unique
  slug    String   @unique
  courses Course[]

  createdAt DateTime @default(now())
}

model Course {
  id           String       @id @default(cuid())
  title        String
  slug         String       @unique
  description  String       @db.Text
  shortDesc    String?
  thumbnail    String?
  promoVideo   String?
  difficulty   Difficulty   @default(BEGINNER)
  courseType   CourseType   @default(FULL_COURSE)
  status       CourseStatus @default(DRAFT)
  previewCount Int          @default(1)
  price        Decimal?     @db.Decimal(10, 2)
  baseCurrency String       @default("NGN")
  duration     Int? // total minutes, computed on publish
  requirements Json? // String[] — what students need before starting
  includes     Json? // String[] — what the course provides (video hours, cert, etc.)

  certificateEnabled Boolean @default(false)
  examGated          Boolean @default(false)
  metaTitle          String?
  metaDescription    String?

  finalExamId String? @unique
  finalExam   Exam?   @relation("CourseFinalExam", fields: [finalExamId], references: [id])

  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])
  instructorId String
  instructor   User      @relation("InstructorCourses", fields: [instructorId], references: [id])

  featuredOrder Int? // 1–8 = appears on landing page in this position

  modules              Module[]
  enrollments          Enrollment[]
  instructors          CourseInstructor[]
  courseInvites        CourseInvite[]
  reviews              CourseReview[]
  revisions            CourseRevision[]
  feedbackItems        CourseFeedbackItem[]
  ratings              CourseRating[]
  pricingProposals     CoursePricingProposal[]
  purchaseOrders       PurchaseOrder[]
  instructorEarnings   InstructorEarning[]
  scheduleEvents       ScheduleEvent[]
  marketplaceResources MarketplaceResource[]
  programs             ProgramCourse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Programs, cohorts, and admissions ---------------------------------------

model School {
  id            String       @id @default(cuid())
  name          String       @unique
  slug          String       @unique
  description   String       @db.Text
  status        SchoolStatus @default(DRAFT)
  featuredOrder Int?
  programs      Program[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, featuredOrder])
}

model Program {
  id                       String                           @id @default(cuid())
  schoolId                 String
  title                    String
  slug                     String                           @unique
  shortDescription         String
  description              String                           @db.Text
  level                    ProgramLevel                     @default(BEGINNER)
  estimatedDurationWeeks   Int
  weeklyCommitmentHours    Int?
  deliveryMode             ProgramDeliveryMode              @default(ONLINE_LIVE)
  status                   ProgramStatus                    @default(DRAFT)
  outcomes                 Json
  requirements             Json
  skills                   Json
  thumbnail                String?
  metaTitle                String?
  metaDescription          String?
  school                   School                           @relation(fields: [schoolId], references: [id])
  courses                  ProgramCourse[]
  cohorts                  Cohort[]
  communitySpaces          CommunitySpace[]
  organizationSeatPackages OrganizationSeatPackage[]
  organizationAssignments  OrganizationLearningAssignment[]
  createdAt                DateTime                         @default(now())
  updatedAt                DateTime                         @updatedAt

  @@index([schoolId, status])
}

model ProgramCourse {
  programId                   String
  courseId                    String
  position                    Int
  required                    Boolean @default(true)
  minimumCompletionPercentage Int     @default(80)
  program                     Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  course                      Course  @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@id([programId, courseId])
  @@unique([programId, position])
}

model Cohort {
  id                       String                           @id @default(cuid())
  programId                String
  title                    String
  slug                     String                           @unique
  status                   CohortStatus                     @default(DRAFT)
  applicationOpenAt        DateTime
  applicationCloseAt       DateTime
  startsAt                 DateTime
  endsAt                   DateTime
  timezone                 String                           @default("Africa/Lagos")
  capacity                 Int
  price                    Decimal?                         @db.Decimal(10, 2)
  currency                 String                           @default("NGN")
  applicationRequired      Boolean                          @default(true)
  graduationRules          Json
  scheduleSummary          String
  weeklySchedule           Json?
  leadInstructorId         String?
  organizationId           String?
  program                  Program                          @relation(fields: [programId], references: [id], onDelete: Restrict)
  leadInstructor           User?                            @relation("CohortLeadInstructor", fields: [leadInstructorId], references: [id], onDelete: SetNull)
  applications             CohortApplication[]
  memberships              CohortMembership[]
  announcements            Announcement[]
  scheduleEvents           ScheduleEvent[]
  projects                 CohortProject[]
  credentials              Credential[]
  mentorAssignments        CohortMentorAssignment[]
  mentorBookings           MentorBooking[]
  communitySpaces          CommunitySpace[]
  organization             Organization?                    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  organizationSeatPackages OrganizationSeatPackage[]
  organizationAssignments  OrganizationLearningAssignment[]
  createdAt                DateTime                         @default(now())
  updatedAt                DateTime                         @updatedAt

  @@index([programId, status, startsAt])
  @@index([applicationOpenAt, applicationCloseAt])
  @@index([organizationId, status])
}

// --- Learning community and career hub -------------------------------------

model CommunitySpace {
  id          String                   @id @default(cuid())
  slug        String                   @unique
  title       String
  description String                   @db.Text
  kind        CommunitySpaceKind
  visibility  CommunitySpaceVisibility @default(PUBLIC)
  status      CommunitySpaceStatus     @default(PUBLISHED)
  programId   String?
  cohortId    String?
  createdById String?
  guidelines  Json?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  program     Program?              @relation(fields: [programId], references: [id], onDelete: Cascade)
  cohort      Cohort?               @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  createdBy   User?                 @relation("CommunitySpaceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  memberships CommunityMembership[]
  posts       CommunityPost[]

  @@index([status, visibility])
  @@index([programId])
  @@index([cohortId])
}

model CommunityMembership {
  id        String                    @id @default(cuid())
  spaceId   String
  userId    String
  role      CommunityMembershipRole   @default(MEMBER)
  status    CommunityMembershipStatus @default(ACTIVE)
  joinedAt  DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  space CommunitySpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@index([userId, status])
}

model CommunityPost {
  id        String              @id @default(cuid())
  spaceId   String
  authorId  String
  parentId  String?
  title     String?
  body      String              @db.Text
  status    CommunityPostStatus @default(PUBLISHED)
  isPinned  Boolean             @default(false)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  space   CommunitySpace        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  author  User                  @relation("CommunityPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent  CommunityPost?        @relation("CommunityPostReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies CommunityPost[]       @relation("CommunityPostReplies")
  reports CommunityPostReport[]

  @@index([spaceId, status, createdAt])
  @@index([parentId, status, createdAt])
  @@index([authorId])
}

model CommunityPostReport {
  id           String                @id @default(cuid())
  postId       String
  reporterId   String
  reason       CommunityReportReason
  details      String?               @db.Text
  status       CommunityReportStatus @default(OPEN)
  reviewedById String?
  reviewedAt   DateTime?
  resolution   String?               @db.Text
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  post       CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter   User          @relation("CommunityReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy User?         @relation("CommunityReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([postId, reporterId])
  @@index([status, createdAt])
}

model CareerOpportunity {
  id                  String                  @id @default(cuid())
  slug                String                  @unique
  company             String
  role                String
  summary             String
  description         String                  @db.Text
  location            String
  workplaceType       CareerWorkplaceType
  employmentType      CareerEmploymentType
  level               CareerOpportunityLevel
  skills              Json
  salaryText          String?
  applicationUrl      String
  source              String
  applicationDeadline DateTime?
  postedAt            DateTime
  status              CareerOpportunityStatus @default(DRAFT)
  featured            Boolean                 @default(false)
  createdById         String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  createdBy User?                       @relation("CareerOpportunityCreator", fields: [createdById], references: [id], onDelete: SetNull)
  saves     SavedCareerOpportunity[]
  interests CareerOpportunityInterest[]

  @@index([status, postedAt])
  @@index([workplaceType, employmentType, level])
}

model SavedCareerOpportunity {
  id            String   @id @default(cuid())
  opportunityId String
  userId        String
  createdAt     DateTime @default(now())

  opportunity CareerOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, userId])
  @@index([userId, createdAt])
}

model CareerOpportunityInterest {
  id            String                          @id @default(cuid())
  opportunityId String
  userId        String
  status        CareerOpportunityInterestStatus @default(STARTED)
  appliedAt     DateTime?
  createdAt     DateTime                        @default(now())
  updatedAt     DateTime                        @updatedAt

  opportunity CareerOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, userId])
  @@index([userId, status])
}

model CareerTalentProfile {
  id                 String               @id @default(cuid())
  userId             String               @unique
  discoverable       Boolean              @default(false)
  targetRoles        Json
  skills             Json
  availability       String?
  preferredWorkplace CareerWorkplaceType?
  cvUrl              String?
  statement          String?              @db.Text
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- Organizations and team learning ---------------------------------------

model Organization {
  id             String             @id @default(cuid())
  name           String
  slug           String             @unique
  type           OrganizationType
  status         OrganizationStatus @default(PENDING_REVIEW)
  description    String?            @db.Text
  websiteUrl     String?
  officialDomain String?
  country        String?
  logoUrl        String?
  requestedById  String?
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  requestedBy  User?                            @relation("OrganizationRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedBy   User?                            @relation("OrganizationApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  members      OrganizationMember[]
  teams        OrganizationTeam[]
  invitations  OrganizationInvitation[]
  seatPackages OrganizationSeatPackage[]
  assignments  OrganizationLearningAssignment[]
  invoices     OrganizationInvoice[]
  cohorts      Cohort[]

  @@index([status, createdAt])
  @@index([officialDomain])
}

model OrganizationTeam {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      OrganizationTeamMember[]
  invitations  OrganizationInvitation[]
  assignments  OrganizationLearningAssignment[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model OrganizationMember {
  id             String                   @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationMemberRole   @default(LEARNER)
  status         OrganizationMemberStatus @default(ACTIVE)
  jobTitle       String?
  joinedAt       DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  organization    Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  teams           OrganizationTeamMember[]
  seatAllocations OrganizationSeatAllocation[]

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, role, status])
}

model OrganizationTeamMember {
  id                   String   @id @default(cuid())
  teamId               String
  organizationMemberId String
  addedAt              DateTime @default(now())

  team               OrganizationTeam   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  organizationMember OrganizationMember @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)

  @@unique([teamId, organizationMemberId])
  @@index([organizationMemberId])
}

model OrganizationInvitation {
  id             String                       @id @default(cuid())
  organizationId String
  teamId         String?
  email          String
  role           OrganizationMemberRole       @default(LEARNER)
  status         OrganizationInvitationStatus @default(PENDING)
  tokenHash      String                       @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         OrganizationTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  invitedBy    User              @relation("OrganizationInvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([organizationId, status, createdAt])
  @@index([email, status])
}

model OrganizationSeatPackage {
  id             String                        @id @default(cuid())
  organizationId String
  programId      String?
  cohortId       String?
  quantity       Int
  pricePerSeat   Decimal                       @db.Decimal(12, 2)
  currency       String                        @default("NGN")
  status         OrganizationSeatPackageStatus @default(REQUESTED)
  startsAt       DateTime?
  expiresAt      DateTime?
  createdById    String
  notes          String?                       @db.Text
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt

  organization Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  program      Program?                         @relation(fields: [programId], references: [id], onDelete: Restrict)
  cohort       Cohort?                          @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  createdBy    User                             @relation("OrganizationSeatPackageCreator", fields: [createdById], references: [id], onDelete: Restrict)
  allocations  OrganizationSeatAllocation[]
  assignments  OrganizationLearningAssignment[]
  invoice      OrganizationInvoice?

  @@index([organizationId, status])
  @@index([programId])
  @@index([cohortId])
}

model OrganizationSeatAllocation {
  id                   String                           @id @default(cuid())
  seatPackageId        String
  organizationMemberId String
  allocatedById        String
  status               OrganizationSeatAllocationStatus @default(ACTIVE)
  assignedAt           DateTime                         @default(now())
  revokedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime                         @default(now())
  updatedAt            DateTime                         @updatedAt

  seatPackage        OrganizationSeatPackage @relation(fields: [seatPackageId], references: [id], onDelete: Cascade)
  organizationMember OrganizationMember      @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)
  allocatedBy        User                    @relation("OrganizationSeatAllocator", fields: [allocatedById], references: [id], onDelete: Restrict)

  @@unique([seatPackageId, organizationMemberId])
  @@index([organizationMemberId, status])
  @@index([seatPackageId, status])
}

model OrganizationLearningAssignment {
  id             String                       @id @default(cuid())
  organizationId String
  teamId         String?
  seatPackageId  String
  programId      String?
  cohortId       String?
  title          String
  description    String?                      @db.Text
  dueAt          DateTime?
  status         OrganizationAssignmentStatus @default(ACTIVE)
  createdById    String
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         OrganizationTeam?       @relation(fields: [teamId], references: [id], onDelete: SetNull)
  seatPackage  OrganizationSeatPackage @relation(fields: [seatPackageId], references: [id], onDelete: Restrict)
  program      Program?                @relation(fields: [programId], references: [id], onDelete: Restrict)
  cohort       Cohort?                 @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  createdBy    User                    @relation("OrganizationAssignmentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, status, dueAt])
  @@index([teamId, status])
  @@index([seatPackageId])
}

model OrganizationInvoice {
  id             String                    @id @default(cuid())
  organizationId String
  seatPackageId  String                    @unique
  number         String                    @unique
  amount         Decimal                   @db.Decimal(12, 2)
  currency       String                    @default("NGN")
  status         OrganizationInvoiceStatus @default(ISSUED)
  issuedById     String
  issuedAt       DateTime                  @default(now())
  dueAt          DateTime?
  paidAt         DateTime?
  metadata       Json?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  seatPackage  OrganizationSeatPackage @relation(fields: [seatPackageId], references: [id], onDelete: Restrict)
  issuedBy     User                    @relation("OrganizationInvoiceIssuer", fields: [issuedById], references: [id], onDelete: Restrict)

  @@index([organizationId, status, issuedAt])
}

model CohortApplication {
  id             String                  @id @default(cuid())
  cohortId       String
  userId         String
  status         CohortApplicationStatus @default(DRAFT)
  background     String                  @db.Text
  goals          String                  @db.Text
  prerequisites  String                  @db.Text
  portfolioUrl   String?
  answers        Json
  submittedAt    DateTime?
  reviewedAt     DateTime?
  reviewedById   String?
  reviewNote     String?                 @db.Text
  offerExpiresAt DateTime?
  cohort         Cohort                  @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user           User                    @relation("CohortApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy     User?                   @relation("CohortApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  purchaseOrder  PurchaseOrder?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([cohortId, userId])
  @@index([cohortId, status, submittedAt])
  @@index([userId, status])
}

model CohortMembership {
  id          String                 @id @default(cuid())
  cohortId    String
  userId      String
  role        CohortMembershipRole   @default(LEARNER)
  status      CohortMembershipStatus @default(INVITED)
  joinedAt    DateTime?
  completedAt DateTime?
  graduatedAt DateTime?
  cohort      Cohort                 @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([cohortId, userId])
  @@index([userId, status])
}

model CohortMentorAssignment {
  id         String                       @id @default(cuid())
  cohortId   String
  mentorId   String
  role       String                       @default("Cohort mentor")
  focusAreas Json
  status     CohortMentorAssignmentStatus @default(ACTIVE)
  assignedAt DateTime                     @default(now())
  cohort     Cohort                       @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  mentor     User                         @relation("CohortMentorAssignments", fields: [mentorId], references: [id], onDelete: Restrict)
  createdAt  DateTime                     @default(now())
  updatedAt  DateTime                     @updatedAt

  @@unique([cohortId, mentorId])
  @@index([cohortId, status])
  @@index([mentorId, status])
}

// --- Applied projects, review, showcase, and credentials ---------------------

model CohortProject {
  id               String                   @id @default(cuid())
  cohortId         String
  createdById      String
  title            String
  slug             String
  brief            String                   @db.Text
  deliverables     Json
  dueAt            DateTime?
  status           CohortProjectStatus      @default(DRAFT)
  showcaseEligible Boolean                  @default(true)
  credentialTitle  String
  cohort           Cohort                   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  createdBy        User                     @relation("CohortProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  rubricCriteria   ProjectRubricCriterion[]
  submissions      ProjectSubmission[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@unique([cohortId, slug])
  @@index([cohortId, status, dueAt])
}

model ProjectRubricCriterion {
  id          String                            @id @default(cuid())
  projectId   String
  key         String
  title       String
  description String                            @db.Text
  maxScore    Int                               @default(5)
  position    Int
  project     CohortProject                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scores      ProjectSubmissionCriterionScore[]
  createdAt   DateTime                          @default(now())
  updatedAt   DateTime                          @updatedAt

  @@unique([projectId, key])
  @@unique([projectId, position])
}

model ProjectSubmission {
  id                  String                     @id @default(cuid())
  projectId           String
  userId              String
  status              ProjectSubmissionStatus    @default(DRAFT)
  title               String
  summary             String                     @db.Text
  artifactUrl         String?
  repositoryUrl       String?
  demoUrl             String?
  coverImageUrl       String?
  showcaseConsent     Boolean                    @default(false)
  currentVersion      Int                        @default(0)
  submittedAt         DateTime?
  reviewedAt          DateTime?
  reviewedById        String?
  approvedAt          DateTime?
  showcaseSlug        String?                    @unique
  showcasePublishedAt DateTime?
  project             CohortProject              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user                User                       @relation("ProjectSubmitter", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy          User?                      @relation("ProjectSubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  versions            ProjectSubmissionVersion[]
  reviews             ProjectSubmissionReview[]
  credential          Credential?
  mentorBookings      MentorBooking[]
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@unique([projectId, userId])
  @@index([projectId, status, submittedAt])
  @@index([userId, status])
  @@index([showcasePublishedAt])
}

model ProjectSubmissionVersion {
  id            String            @id @default(cuid())
  submissionId  String
  version       Int
  title         String
  summary       String            @db.Text
  artifactUrl   String?
  repositoryUrl String?
  demoUrl       String?
  coverImageUrl String?
  submittedAt   DateTime
  submission    ProjectSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  createdAt     DateTime          @default(now())

  @@unique([submissionId, version])
  @@index([submissionId, submittedAt])
}

model ProjectSubmissionReview {
  id           String                            @id @default(cuid())
  submissionId String
  version      Int
  reviewerId   String
  decision     ProjectReviewDecision
  overallNote  String                            @db.Text
  totalScore   Int
  maxScore     Int
  submission   ProjectSubmission                 @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer     User                              @relation("ProjectReviewAuthor", fields: [reviewerId], references: [id], onDelete: Restrict)
  scores       ProjectSubmissionCriterionScore[]
  createdAt    DateTime                          @default(now())

  @@unique([submissionId, version])
  @@index([reviewerId, createdAt])
}

model ProjectSubmissionCriterionScore {
  id          String                  @id @default(cuid())
  reviewId    String
  criterionId String
  score       Int
  note        String?                 @db.Text
  review      ProjectSubmissionReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  criterion   ProjectRubricCriterion  @relation(fields: [criterionId], references: [id], onDelete: Restrict)

  @@unique([reviewId, criterionId])
  @@index([criterionId])
}

model Credential {
  id               String            @id @default(cuid())
  verificationCode String            @unique
  evidenceHash     String            @unique
  userId           String
  cohortId         String
  submissionId     String            @unique
  title            String
  status           CredentialStatus  @default(ACTIVE)
  issuedAt         DateTime          @default(now())
  revokedAt        DateTime?
  revocationReason String?           @db.Text
  metadata         Json
  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  cohort           Cohort            @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  submission       ProjectSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([userId, issuedAt])
  @@index([cohortId, issuedAt])
  @@index([status])
}

