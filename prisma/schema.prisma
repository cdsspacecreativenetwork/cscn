// ─── Billing & Ledger ─────────────────────────────────────────────────────────

model PurchaseOrder {
  id                  String           @id @default(cuid())
  userId              String
  courseId            String?
  resourceId          String?
  mentorBookingId     String?          @unique
  cohortApplicationId String?          @unique
  type                OrderType        @default(COURSE)
  status              OrderStatus      @default(PENDING)
  amount              Decimal          @db.Decimal(12, 2)
  currency            String           @default("NGN")
  provider            PaymentProvider?
  providerReference   String?          @unique
  metadata            Json?
  paidAt              DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  user              User                 @relation("StudentOrders", fields: [userId], references: [id], onDelete: Cascade)
  course            Course?              @relation(fields: [courseId], references: [id], onDelete: SetNull)
  resource          MarketplaceResource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  mentorBooking     MentorBooking?       @relation(fields: [mentorBookingId], references: [id], onDelete: SetNull)
  cohortApplication CohortApplication?   @relation(fields: [cohortApplicationId], references: [id], onDelete: SetNull)
  payments          Payment[]
  earnings          InstructorEarning[]
  refunds           Refund[]
  invoice           Invoice?

  @@index([userId])
  @@index([courseId])
  @@index([resourceId])
  @@index([mentorBookingId])
  @@index([cohortApplicationId])
  @@index([status])
  @@index([createdAt])
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String
  userId            String
  provider          PaymentProvider
  channel           String?
  status            PaymentStatus   @default(PENDING)
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @default("NGN")
  providerReference String?         @unique
  rawPayload        Json?
  paidAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  order    PurchaseOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  earnings InstructorEarning[]
  refunds  Refund[]

  @@index([orderId])
  @@index([userId])
  @@index([provider, status])
  @@index([createdAt])
}

model InstructorEarning {
  id               String        @id @default(cuid())
  instructorId     String
  courseId         String?
  resourceId       String?
  orderId          String?
  paymentId        String?
  grossAmount      Decimal       @db.Decimal(12, 2)
  platformFee      Decimal       @db.Decimal(12, 2)
  instructorAmount Decimal       @db.Decimal(12, 2)
  currency         String        @default("NGN")
  sharePercent     Decimal       @default(80.00) @db.Decimal(5, 2)
  status           EarningStatus @default(PENDING)
  payoutRequestId  String?
  holdUntil        DateTime?
  availableAt      DateTime?
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  instructor    User                 @relation("InstructorEarnings", fields: [instructorId], references: [id], onDelete: Cascade)
