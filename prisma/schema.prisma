model Module {
  id                   String                @id @default(cuid())
  title                String
  position             Int
  isPublished          Boolean               @default(false)
  isDefault            Boolean               @default(false)
  courseId             String
  course               Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons              Lesson[]
  marketplaceResources MarketplaceResource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
}

model Lesson {
  id          String      @id @default(cuid())
  title       String
  overview    String?     @db.Text
  position    Int
  videoUrl    String? // Legacy YouTube URL
  contentType ContentType @default(VIDEO)
  bodyContent String?     @db.Text
  duration    Int? // minutes
  isPreview   Boolean     @default(false)
  isPublished Boolean     @default(false)
  transcript  String?     @db.Text
  moduleId    String
  module      Module      @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  // Mux video hosting
  muxUploadId   String?        @unique
  muxAssetId    String?        @unique
  muxPlaybackId String?        @unique
  muxStatus     MuxVideoStatus @default(NONE)

  resources            LessonResource[]
  marketplaceResources MarketplaceResource[]
  progress             LessonProgress[]
  notes                LessonNote[]
  watchSegments        LessonWatchSegment[]
  quiz                 Quiz?
  scheduleEvents       ScheduleEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId])
}

model LessonResource {
  id       String       @id @default(cuid())
  title    String
  url      String
  type     ResourceType @default(LINK)
  lessonId String
  lesson   Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// --- Resource Marketplace ----------------------------------------------------
model MarketplaceResource {
  id           String              @id @default(cuid())
  ownerId      String
  title        String
  slug         String              @unique
  description  String              @db.Text
  category     ResourceCategory
  status       ResourceStatus      @default(DRAFT)
  thumbnailUrl String?
  filePath     String
  fileName     String
  fileSize     Int?
  mimeType     String?
  isFree       Boolean             @default(true)
  price        Decimal?            @db.Decimal(10, 2)
  currency     String              @default("NGN")
  courseId     String?
  moduleId     String?
  lessonId     String?
  publishedAt  DateTime?
  owner        User                @relation("MarketplaceResourceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  course       Course?             @relation(fields: [courseId], references: [id], onDelete: SetNull)
  module       Module?             @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  lesson       Lesson?             @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  accesses     ResourceAccess[]
  reviews      ResourceReview[]
  downloads    ResourceDownload[]
  orders       PurchaseOrder[]
  earnings     InstructorEarning[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([ownerId, status])
  @@index([status, publishedAt])
  @@index([courseId])
}

model ResourceAccess {
  id          String               @id @default(cuid())
  resourceId  String
  userId      String
  source      ResourceAccessSource
  orderId     String?              @unique
  grantedById String?
  expiresAt   DateTime?
  revokedAt   DateTime?
  resource    MarketplaceResource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([resourceId, userId])
  @@index([userId, revokedAt])
}

model ResourceReview {
  id         String               @id @default(cuid())
  resourceId String
  reviewerId String
  status     ResourceReviewStatus
  note       String?              @db.Text
  resource   MarketplaceResource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  reviewer   User                 @relation("ResourceReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  createdAt  DateTime             @default(now())

  @@index([resourceId, createdAt])
}

model ResourceDownload {
  id         String              @id @default(cuid())
  resourceId String
  userId     String
  resource   MarketplaceResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt  DateTime            @default(now())

  @@index([resourceId])
  @@index([userId])
}

enum ResourceCategory {
  TEMPLATE
  STARTER_KIT
  MOCKUP
  ASSET
  GUIDE
  OTHER
}

enum ResourceStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum ResourceAccessSource {
  FREE_CLAIM
  PURCHASE
  GRANT
}

enum ResourceReviewStatus {
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

model Quiz {
  id               String   @id @default(cuid())
  lessonId         String   @unique
  lesson           Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  mode             QuizMode @default(PRACTICE)
  instructions     String?  @db.Text
  passingScore     Int?
  maxAttempts      Int?
  showAnswers      Boolean  @default(true)
  gateUntilPassed  Boolean  @default(false)
  shuffleQuestions Boolean  @default(false)
  timeLimitMinutes Int?

  questions QuizQuestion[]
  attempts  QuizAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lessonId])
}

model QuizQuestion {
  id          String           @id @default(cuid())
  quizId      String
  quiz        Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type        QuizQuestionType @default(SINGLE_CHOICE)
  prompt      String           @db.Text
  explanation String?          @db.Text
  points      Int              @default(1)
  position    Int
  required    Boolean          @default(true)

  options QuizOption[]
  answers QuizAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quizId])
}

model QuizOption {
  id         String       @id @default(cuid())
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String       @db.Text
  isCorrect  Boolean      @default(false)
  position   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([questionId])
}

model QuizAttempt {
  id            String            @id @default(cuid())
  quizId        String
  quiz          Quiz              @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  attemptNumber Int
  status        QuizAttemptStatus @default(IN_PROGRESS)
  score         Float             @default(0)
  maxScore      Float             @default(0)
  percentage    Float             @default(0)
  passed        Boolean           @default(false)
  startedAt     DateTime          @default(now())
  submittedAt   DateTime?

  answers QuizAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([quizId, userId, attemptNumber])
  @@index([quizId])
  @@index([userId])
  @@index([userId, status])
}

model QuizAnswer {
  id                     String       @id @default(cuid())
  attemptId              String
  attempt                QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId             String
  question               QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionIds      Json?
  isCorrect              Boolean      @default(false)
  pointsAwarded          Float        @default(0)
  questionPromptSnapshot String       @db.Text
  optionSnapshots        Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

model Enrollment {
  id       String           @id @default(cuid())
  userId   String
  courseId String
  status   EnrollmentStatus @default(ACTIVE)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)

  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model LessonProgress {
  id              String    @id @default(cuid())
  userId          String
  lessonId        String
  lastSeekTime    Float     @default(0.0)
  percentComplete Int       @default(0)
  completedAt     DateTime?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson          Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
}

